<%- layout('layouts/boilerplate') %>

    <div class="container my-4">

        <!-- Listing Title -->
        <div class="text-center mb-4">
            <h3 class="fw-bold text-gradient">
                <%= listing.title %>
            </h3>
            <p class="text-muted">
                <i class="fas fa-map-marker-alt me-1"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <!-- Main Listing Card -->
        <div class="card show-card mb-4">
            <img src="<%= listing.image.url %>" class="card-img-top show-image" alt="Listing Image">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3 flex-column flex-md-row">
                    <p class="card-text text-muted mb-2 mb-md-0">
                        <small>Owned by <i class="fw-semibold">
                                <%= listing.owner.username %>
                            </i></small>
                    </p>
                    <span class="price-tag mt-2 mt-md-0">
                        ₹<%= listing.price.toLocaleString("en-IN") %> / night
                    </span>
                </div>
                <p class="card-text mb-4">
                    <%= listing.description %>
                </p>

                <!-- Optional Info -->
                <div class="row">
                    <!-- You can add icons for guests, bedrooms, bathrooms if needed -->
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <% if(currUser && listing.owner._id.equals(currUser._id)){ %>
            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn-custom-dark">
                    <i class="fas fa-edit me-2"></i>Edit Listing
                </a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn-custom-primary">
                        <i class="fas fa-trash me-2"></i>Delete Listing
                    </button>
                </form>
            </div>
            <% } %>

                <hr class="my-4">

                <!-- Leave a Review -->
                <% if(currUser) { %>
                    <div class="mb-5">
                        <h4 class="text-center text-md-start mb-4">Leave a Review</h4>
                        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation"
                            novalidate>
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Rating</label>
                                <fieldset class="starability-slot">
                                    <input type="radio" id="rate0" class="input-no-rate" name="review[rating]" value="0"
                                        checked aria-label="No rating" />
                                    <input type="radio" id="rate1" name="review[rating]" value="1" />
                                    <label for="rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                                    <label for="rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="rate3" name="review[rating]" value="3" />
                                    <label for="rate3" title="Average">3 stars</label>
                                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                                    <label for="rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="rate5" name="review[rating]" value="5" />
                                    <label for="rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>

                            <div class="mb-4">
                                <label for="comment" class="form-label fw-semibold">Comments</label>
                                <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control"
                                    required></textarea>
                                <div class="invalid-feedback">Please add a comment</div>
                            </div>

                            <div class="text-center text-md-start">
                                <button class="btn-custom-primary px-5">Submit Review</button>
                            </div>
                        </form>
                    </div>
                    <% } %>

                        <hr class="my-4">

                        <!-- All Reviews -->
                        <div class="mb-4">
                            <h5 class="fw-bold mb-4 text-center text-md-start">Guest Reviews (<%= listing.reviews.length
                                    %>)</h5>

                            <div class="row">
                                <% for(let review of listing.reviews) { %>
                                    <div class="col-12 col-md-6 mb-3">
                                        <div class="review-card">
                                            <div class="card-body p-0">
                                                <div class="d-flex align-items-center mb-3">
                                                    <div class="flex-grow-1">
                                                        <h6 class="card-title mb-1 fw-semibold">@<%=
                                                                review.author.username %>
                                                        </h6>
                                                        <div class="starability-result"
                                                            data-rating="<%= review.rating %>">
                                                            <% for(let i=0;i<review.rating;i++){ %>
                                                                <i class="fas fa-star"></i>
                                                                <% } %>
                                                                    <% for(let i=review.rating;i<5;i++){ %>
                                                                        <i class="far fa-star"></i>
                                                                        <% } %>
                                                        </div>
                                                    </div>
                                                    <small class="text-muted">
                                                        <%= review.createdAt.toDateString() %>
                                                    </small>
                                                </div>
                                                <p class="card-text mb-3">
                                                    <%= review.comment %>
                                                </p>
                                                <% if(currUser && review.author._id.equals(currUser._id)) { %>
                                                    <form method="POST"
                                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                        <button class="btn btn-outline-danger btn-sm">Delete</button>
                                                    </form>
                                                    <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                        </div>

    </div>